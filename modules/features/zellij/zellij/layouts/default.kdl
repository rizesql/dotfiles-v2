layout {
  default_tab_template {
    pane size=2 borderless=true {
      plugin location="zjstatus" {
        color_bg      "16"
        color_surface "236"
        color_overlay "238"
        color_text    "252"
        color_muted   "244"
        color_red     "1"
        color_green   "2"
        color_yellow  "3"
        color_blue    "4"
        color_magenta "5"
        color_cyan    "6"
        color_accent  "208"

        format_left   "{mode}#[bg=$bg] {tabs}"
        format_center ""
        format_right  "#[bg=$bg,fg=$blue]#[bg=$blue,fg=$bg,bold] #[bg=$surface,fg=$text,bold] {session} #[bg=$overlay,fg=$text,bold]"
        format_space  ""
        format_hide_on_overlength "true"
        format_precedence "crl"

        border_enabled  "false"

        mode_normal        "#[bg=$green,fg=$bg,bold] NORMAL#[bg=$overlay,fg=$green]█"
        mode_locked        "#[bg=$muted,fg=$bg,bold] LOCKED #[bg=$overlay,fg=$muted]█"
        mode_resize        "#[bg=$red,fg=$bg,bold] RESIZE#[bg=$overlay,fg=$red]█"
        mode_pane          "#[bg=$blue,fg=$bg,bold] PANE#[bg=$overlay,fg=$blue]█"
        mode_tab           "#[bg=$cyan,fg=$bg,bold] TAB#[bg=$overlay,fg=$cyan]█"
        mode_scroll        "#[bg=$yellow,fg=$bg,bold] SCROLL#[bg=$overlay,fg=$yellow]█"
        mode_enter_search  "#[bg=$blue,fg=$bg,bold] ENT-SEARCH#[bg=$overlay,fg=$blue]█"
        mode_search        "#[bg=$blue,fg=$bg,bold] SEARCH#[bg=$overlay,fg=$blue]█"
        mode_rename_tab    "#[bg=$cyan,fg=$bg,bold] RENAME-TAB#[bg=$overlay,fg=$cyan]█"
        mode_rename_pane   "#[bg=$blue,fg=$bg,bold] RENAME-PANE#[bg=$overlay,fg=$blue]█"
        mode_session       "#[bg=$magenta,fg=$bg,bold] SESSION#[bg=$overlay,fg=$magenta]█"
        mode_move          "#[bg=$red,fg=$bg,bold] MOVE#[bg=$overlay,fg=$red]█"
        mode_prompt        "#[bg=$blue,fg=$bg,bold] PROMPT#[bg=$overlay,fg=$blue]█"
        mode_tmux          "#[bg=$accent,fg=$bg,bold] TMUX#[bg=$overlay,fg=$accent]█"

        tab_normal              "#[bg=$overlay,fg=$blue]█#[bg=$blue,fg=$bg,bold]{index} #[bg=$surface,fg=$text,bold] {name}{floating_indicator}#[bg=$overlay,fg=$surface,bold]█"
        tab_normal_fullscreen   "#[bg=$overlay,fg=$blue]█#[bg=$blue,fg=$bg,bold]{index} #[bg=$surface,fg=$text,bold] {name}{fullscreen_indicator}#[bg=$overlay,fg=$surface,bold]█"
        tab_normal_sync         "#[bg=$overlay,fg=$blue]█#[bg=$blue,fg=$bg,bold]{index} #[bg=$surface,fg=$text,bold] {name}{sync_indicator}#[bg=$overlay,fg=$surface,bold]█"

        tab_active              "#[bg=$overlay,fg=$accent]█#[bg=$accent,fg=$bg,bold]{index} #[bg=$surface,fg=$text,bold] {name}{floating_indicator}#[bg=$overlay,fg=$surface,bold]█"
        tab_active_fullscreen   "#[bg=$overlay,fg=$accent]█#[bg=$accent,fg=$bg,bold]{index} #[bg=$surface,fg=$text,bold] {name}{fullscreen_indicator}#[bg=$overlay,fg=$surface,bold]█"
        tab_active_sync         "#[bg=$overlay,fg=$accent]█#[bg=$accent,fg=$bg,bold]{index} #[bg=$surface,fg=$text,bold] {name}{sync_indicator}#[bg=$overlay,fg=$surface,bold]█"

        tab_separator           "#[bg=$bg] "

        tab_sync_indicator       " "
        tab_fullscreen_indicator " 󰊓"
        tab_floating_indicator   " 󰹙"
      }
    }
    children
  }
}
