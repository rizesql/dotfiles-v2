[
  {
    "tool": "bash",
    "matches": { "cmd": ["*git add -A*", "*git add .*"] },
    "action": "reject",
    "message": "stage files explicitly with 'git add <file>' — unstaged changes may not be yours"
  },
  {
    "tool": "bash",
    "matches": {
      "cmd": ["*git push --force*", "*git push -f*", "*--force-with-lease*"]
    },
    "action": "reject",
    "message": "never force push. if diverged: 'git fetch origin && git rebase origin/main && git push'"
  },
  {
    "tool": "bash",
    "matches": {
      "cmd": [
        "*git reset --hard*",
        "*git clean -f*",
        "*git clean -df*",
        "*git clean -fd*",
        "*git checkout -f*"
      ]
    },
    "action": "reject",
    "message": "destructive git command rejected — ask for explicit authorization before discarding uncommitted work"
  },
  {
    "tool": "bash",
    "matches": { "cmd": ["rm *", "* && rm *", "* || rm *", "* ; rm *"] },
    "action": "reject",
    "message": "use 'trash <file>' instead of rm — recoverable deletion"
  },
  {
    "tool": "apply_patch",
    "matches": { "path": ["*.env", "*.env.*", "*id_rsa*", "*id_ed25519*"] },
    "action": "reject",
    "message": "patching secrets directly is blocked by policy"
  },
  {
    "tool": "bash",
    "matches": { "cmd": ["* > /dev/null*", "* >> /dev/null*"] },
    "action": "allow"
  },
  {
    "tool": "bash",
    "matches": {
      "cmd": [
        "sed -i*", "sed * -i*", "sed *--in-place*",
        "perl -i*", "perl * -i*", "perl -pi*", "perl * -pi*",
        "*awk *inplace*",
        "tee *",
        "* > *", "* >> *",
        "*writeFileSync*", "*write_text(*", "*write_bytes(*",
        "*open(*, 'w*", "*open(*,'w*", "*open(*, 'a*", "*open(*,'a*",
        "*open(*, \"w*", "*open(*,\"w*", "*open(*, \"a*", "*open(*,\"a*"
      ]
    },
    "action": "reject",
    "message": "don't edit files through bash. use the edit or write tool so the change gets a review baseline. formatters and codegen are fine"
  },
  { "tool": "*", "action": "allow" }
]
