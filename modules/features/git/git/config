[alias]
    main-branch = "!git symbolic-ref refs/remotes/origin/HEAD | cut -d '/' -f4"
    fomo = "!git fetch origin $(git main-branch) && git rebase origin/$(git main-branch) --autostash"
    save = "!git commit -am \"commit\""

[push]
    autoSetupRemote = true

[core]
    editor = code --wait
    excludesfile = ~/.gitignore
    pager = delta

[merge]
    conflictstyle = zdiff3

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    true-colors = always

    file-style = bold
    file-decoration-style = 8 ul
    commit-decoration-style = 8 bold box ul
    hunk-header-style = file line-number syntax
    hunk-header-file-style = bold
    hunk-header-line-number-style = bold 8
    hunk-header-decoration-style = 8 box ul

    line-numbers-left-style = 8
    line-numbers-right-style = 8
    line-numbers-zero-style = 8
    line-numbers-minus-style = bold 1
    line-numbers-plus-style = bold 2

    syntax-theme = base16
    minus-empty-line-marker-style = normal 52
    plus-empty-line-marker-style = normal 22
    minus-style = syntax 52
    minus-emph-style = bold syntax 88
    plus-style = syntax 22
    plus-emph-style = bold syntax 28
    map-styles = \
        bold purple => syntax 53, \
        bold blue => syntax 17, \
        bold cyan => syntax 23, \
        bold yellow => syntax 58
    blame-palette = "232 233 234 235 236"

[include]
    path = ~/.config/git/personal.gitconfig

[includeIf "gitdir:~/work/codestory/**"]
    path = ~/.config/git/codestory.gitconfig
